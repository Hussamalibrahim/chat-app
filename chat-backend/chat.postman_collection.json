      "name": "01. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('user_id', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"hussam\",\n  \"email\": \"hussam@example.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base-url}}/api/v1/auth/register",
              "host": ["{{base-url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.accessToken) {",
                  "        pm.collectionVariables.set('token', json.accessToken);",
                  "    }",
                  "    if (json.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "    }",
                  "    if (json.user && json.user.id) {",
                  "        pm.collectionVariables.set('user_id', json.user.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"hussam\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base-url}}/api/v1/auth/login",
              "host": ["{{base-url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
